{
  "name": "dockvue",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/creator-admin",
    "apps/learner-web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "dev:admin": "npm run start -w @dockvue/creator-admin",
    "dev:learner": "npm run start -w @dockvue/learner-web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "mysql2": "3.15.3"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1"
  }
}
