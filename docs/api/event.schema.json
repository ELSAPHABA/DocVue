{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "enum": [
        "video.uploaded",
        "media.transcode.requested",
        "media.transcode.completed",
        "media.transcode.failed",
        "release.build.requested",
        "release.build.validated",
        "release.published",
        "release.revoked",
        "job.state.changed",
        "progress.updated"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "tenantId",
    "occurredAt",
    "traceId",
    "payload"
  ]
}
